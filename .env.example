# ═════════════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN PARA DESARROLLO
# ⚠️  NUNCA usar estos valores en producción
# ═════════════════════════════════════════════════════════════════════════════

# ─── DJANGO ──────────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production-12345
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# ─── BASE DE DATOS (PostgreSQL) ──────────────────────────────────────────────
DB_NAME=tesis_db
DB_USER=tesis_user
DB_PASSWORD=tesis_password
DB_HOST=db
DB_PORT=5432

PGADMIN_EMAIL=pgadmin@example.com
PGADMIN_PASSWORD=pgadmin

# ─── REDIS / CELERY ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/1
SOCKETIO_REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# ─── CORREO ELECTRÓNICO / GMAIL ──────────────────────────────────────────────
# Para no enviar correos reales en desarrollo, deja console.EmailBackend.
# Para Gmail real usa smtp.EmailBackend y una contrasena de aplicacion de Google.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_app_password
DEFAULT_FROM_EMAIL=Sistema Academico <tu_correo@gmail.com>
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173

# ─── HUNTER EMAIL VERIFIER ───────────────────────────────────────────────────
HUNTER_VALIDATE_EMAILS=True
HUNTER_API_KEY=
HUNTER_TIMEOUT_SECONDS=10

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ─── NGROK (opcional, para compartir el frontend local) ─────────────────────
NGROK_AUTHTOKEN=
